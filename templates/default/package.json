{
  "name": "{{PROJECT_NAME}}",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter @app/web dev",
    "dev:api": "bun run --filter @app/api dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "bun run --filter @pkg/db generate",
    "db:migrate": "bun run --filter @pkg/db migrate",
    "db:studio": "bun run --filter @pkg/db studio",
    "db:push": "bun run --filter @pkg/db push",
    "security": "bun run security:audit && bun run security:deps && bun run security:lockfile",
    "security:audit": "bun run security:osv && bun run security:snyk",
    "security:osv": "bunx @bun-security-scanner/osv",
    "security:snyk": "snyk test || true",
    "security:deps": "depcheck && bun run security:npq",
    "security:npq": "npx npq-hero audit || true",
    "security:lockfile": "lockfile-lint --path bun.lock --allowed-hosts npm --validate-https",
    "security:nodesecure": "nodesecure audit || true",
    "security:scan": "bun-scan || true",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@bun-security-scanner/osv": "^1.0.0",
    "@nodesecure/cli": "^3.1.0",
    "@playwright/test": "^1.49.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "bun-scan": "^1.1.2",
    "csslint": "^1.0.5",
    "depcheck": "^1.4.7",
    "detective-typescript": "^15.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lockfile-lint": "^4.14.1",
    "npq": "^3.0.0",
    "snyk": "^1.1294.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
