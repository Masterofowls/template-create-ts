# Database — set DB_ENABLED=false to run without a database (enable later with db:push)
DB_ENABLED={{DB_ENABLED}}
DATABASE_URL={{DATABASE_URL}}
DB_DIALECT={{DB_DIALECT}}

# API
API_PORT=9001
API_HOST=0.0.0.0
NODE_ENV=development
APP_SECRET=replace-me-with-generated-secret-on-scaffold

# Web
VITE_API_URL=http://localhost:9001
WEB_PORT=9000

# CORS
CORS_ORIGIN=http://localhost:9000
