{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": { "noForEach": "off" },
      "suspicious": { "noExplicitAny": "warn" }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "files": {
    "ignore": [
      "dist",
      "node_modules",
      "test-scaffold",
      "verify-app",
      "ci-smoke",
      "ci-smoke-nodb",
      "localhost-test",
      "no-db-test",
      "test-dev-app",
      "v12-test",
      "fastify-only-test",
      "git-fix-test",
      "templates/**/node_modules",
      "templates/**/dist"
    ]
  }
}
